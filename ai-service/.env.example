# Konfigurasi AI Service FESR. Salin menjadi .env lalu sesuaikan.
# Prefix seluruh variabel adalah FESR_AI_

FESR_AI_APP_NAME="FESR AI Service"
FESR_AI_DEBUG=false

FESR_AI_HOST=127.0.0.1
FESR_AI_PORT=8001

# Asal yang diizinkan untuk Stock dan dokumentasi OpenAPI.
FESR_AI_CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# Model Whisper. Nilai yang umum: tiny, base, small, medium, large-v3.
FESR_AI_WHISPER_MODEL=small
FESR_AI_WHISPER_DEVICE=cpu
# int8 berjalan di CPU; ubah ke float16 bila memakai GPU CUDA.
FESR_AI_WHISPER_COMPUTE_TYPE=int8
FESR_AI_WHISPER_LANGUAGE=id
FESR_AI_WHISPER_MODEL_DIR=models
